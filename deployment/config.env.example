# =============================================================================
# ContentForge deployment configuration - THE ONLY FILE YOU EDIT
# =============================================================================
#
#   cp deployment/config.env.example deployment/config.env
#   # edit the two REQUIRED values below
#   make deploy
#
# `make deploy` is idempotent: run it as many times as you like. It provisions
# anything missing, updates anything changed, and leaves everything else alone.
#
# SECURITY: config.env is git-ignored. Even so, do not put secret *values* here.
# The only field that accepts one is CMS_API_TOKEN, and bootstrap.sh moves it
# straight into Secret Manager and never writes it anywhere else. Leave it empty
# and the agent runs in draft-only mode.
# =============================================================================


# --- REQUIRED ----------------------------------------------------------------

# Your Google Cloud project id. Must already exist and have billing enabled.
#   gcloud projects create my-project --set-as-default
#   gcloud billing projects link my-project --billing-account=XXXXXX-XXXXXX-XXXXXX
PROJECT_ID=""

# Who may use the agent. The service is NOT public: it can publish to a blog, so
# an open endpoint would let anyone drive it. Accepts any IAM member form.
#   user:you@example.com
#   group:editorial@example.com
#   domain:example.com
INVOKER="user:CHANGE_ME@example.com"


# --- Deployment target -------------------------------------------------------

# Where the agent runs:
#   agent-engine  Managed runtime on the Gemini Enterprise Agent Platform.
#                 Supplies managed sessions + Memory Bank. Least operational work.
#   cloud-run     Our container, our Cloud SQL session store, our scaling policy.
#                 More control, more moving parts.
DEPLOY_TARGET="agent-engine"

# dev | staging | prod. Drives sizing, deletion protection, DLP enablement and
# backup retention. `prod` additionally refuses to boot with the publish
# confirmation gate disabled.
ENVIRONMENT="dev"

# Region for compute, database and container registry.
REGION="us-central1"


# --- Models ------------------------------------------------------------------
#
# Defaults come from content_forge/models.py: gemini-3.5-flash for the
# reasoning-heavy roles, gemini-3.5-flash-lite for the mechanical ones.
# Uncomment to override a role. Note that Gemini 3.5 Pro is delayed with no GA
# date, so there is currently no Pro tier to route to.
#
# gemini-3.6-flash is newer and stronger on multi-step work - a good upgrade for
# the two reasoning roles if you want more quality per post:
#
# MODEL_PLANNER="gemini-3.6-flash"
# MODEL_EDITORIAL="gemini-3.6-flash"
# MODEL_RESEARCH="gemini-3.5-flash"
# MODEL_EXTRACTION="gemini-3.5-flash-lite"
# MODEL_GUARDRAIL="gemini-3.5-flash-lite"


# --- Optional: live CMS ------------------------------------------------------
#
# Leave empty to run in draft-only mode: approved posts are written to a local
# outbox and the agent says explicitly that nothing was published to a real CMS.
#
# If set, bootstrap.sh writes this into Secret Manager and then forgets it. It is
# never baked into the image, never placed in the service environment, and never
# written to Terraform state.
CMS_API_TOKEN=""


# --- Optional: automatic redeploy on merge to main ---------------------------
#
# Set to your GitHub repo to provision Workload Identity Federation, so GitHub
# Actions can deploy without any long-lived service-account key. bootstrap.sh
# prints the exact repository variables to paste into GitHub afterwards.
# Leave empty to skip CI/CD entirely.
GITHUB_REPO=""   # e.g. "marcelaldecoa/ai-in-5-days-private"


# --- Optional: advanced ------------------------------------------------------

# Bucket for Terraform remote state. Defaults to "${PROJECT_ID}-contentforge-tfstate".
# Created automatically if missing.
TF_STATE_BUCKET=""

# Max Cloud Run instances (cloud-run target only).
MAX_INSTANCES="10"

# Set to "1" to run terraform plan and stop, without applying. Useful for review.
PLAN_ONLY="0"
