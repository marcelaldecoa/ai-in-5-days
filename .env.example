# =============================================================================
# ContentForge - LOCAL development configuration
#
#   cp .env.example .env
#   # paste your Gemini API key below
#   make doctor      # tells you exactly what is configured and what is missing
#   make web         # chat with the agent
#
# This file is for running on your machine. Deploying to Google Cloud uses a
# different file - deployment/config.env - and needs nothing from here.
#
# `.env` is git-ignored. Never commit a real key.
# =============================================================================


# --- QUICKSTART: the only line you need ---------------------------------------
#
# Get a free key at https://aistudio.google.com/apikey
#
GOOGLE_API_KEY=

# Tells the SDK to use the Gemini Developer API (your key) rather than the
# Gemini Enterprise Agent Platform (cloud credentials).
#
# You can leave this unset: when an API key is present and this is not set,
# ContentForge selects API-key mode automatically. Set it to 0 explicitly if you
# also have gcloud credentials on this machine and want the key to win.
GOOGLE_GENAI_USE_VERTEXAI=0

# That is genuinely everything. Every setting below has a working default, and
# the agent runs fully offline against a bundled corpus. Run `make doctor` to
# see which subsystems are live and which are degraded.


# =============================================================================
# OPTIONAL - only if you want to run against real cloud services locally
# =============================================================================

# --- Using the platform instead of an API key --------------------------------
#
# To use the Gemini Enterprise Agent Platform (formerly Vertex AI) from your
# machine, authenticate once:
#     gcloud auth application-default login
# then set these and clear GOOGLE_API_KEY above:
#
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1


# --- Models -------------------------------------------------------------------
#
# Defaults: gemini-3.5-flash for planning/editorial/research,
# gemini-3.5-flash-lite for extraction and the guardrail.
#
# Gemini 3.5 Pro is delayed with no GA date, so there is no Pro tier to route to.
# gemini-3.6-flash is newer and stronger on multi-step work:
#
# CONTENTFORGE_MODEL_PLANNER=gemini-3.6-flash
# CONTENTFORGE_MODEL_EDITORIAL=gemini-3.6-flash
# CONTENTFORGE_MODEL_RESEARCH=gemini-3.5-flash
# CONTENTFORGE_MODEL_EXTRACTION=gemini-3.5-flash-lite
# CONTENTFORGE_MODEL_GUARDRAIL=gemini-3.5-flash-lite


# --- Persistence --------------------------------------------------------------
#
# Default is a local SQLite file, so session state survives a restart with no
# cloud setup. Set to `vertex_ai` (plus an Agent Engine id) for managed sessions
# and Memory Bank, or point DATABASE_URL at Postgres.
#
# CONTENTFORGE_SESSION_BACKEND=database
# CONTENTFORGE_DATABASE_URL=sqlite+aiosqlite:///./.contentforge/sessions.db
# CONTENTFORGE_AGENT_ENGINE_ID=


# --- Retrieval ----------------------------------------------------------------
#
# Unset means the bundled corpus in content_forge/memory/corpus/ - 8 published
# posts and 20 sourced claims, enough to exercise the whole pipeline offline.
#
# CONTENTFORGE_VERTEX_SEARCH_DATASTORE=


# --- Observability ------------------------------------------------------------
#
# Logs are structured JSON on stderr in every mode. Tracing goes to the console
# unless you point it somewhere. DLP redaction needs a cloud project; the regex
# redaction tier is always on regardless.
#
# CONTENTFORGE_LOG_LEVEL=INFO
# CONTENTFORGE_ENABLE_CLOUD_TRACE=0
# CONTENTFORGE_ENABLE_DLP_REDACTION=0
CONTENTFORGE_ENVIRONMENT=local


# --- Secrets ------------------------------------------------------------------
#
# In a deployed environment these hold Secret Manager *resource names*, never
# values, and config.py fetches the value at use time. Locally you normally
# leave them empty: with no CMS credential the agent runs in draft-only mode and
# says so explicitly rather than pretending to have published.
#
# CONTENTFORGE_CMS_API_TOKEN_SECRET=
# CONTENTFORGE_DB_PASSWORD_SECRET=


# --- Human-in-the-loop --------------------------------------------------------
#
# Publishing always requires explicit human approval. Set to 0 ONLY for
# automated evaluation against the mock CMS; config.py refuses to boot in prod
# with it disabled.
CONTENTFORGE_REQUIRE_PUBLISH_CONFIRMATION=1
